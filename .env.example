# SMTP for quote enquiries — currently Brevo, switch to Hostinger later by changing these values only
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=          # Brevo SMTP login (looks like xxxx@smtp-brevo.com)
SMTP_PASS=          # Brevo SMTP key
SMTP_FROM=website@yourdomain.com
QUOTE_TO=client@gmail.com
